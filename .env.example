# Supabase project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (Dashboard → Settings → API Keys).
# Safe to expose to the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only if strictly needed, server-only. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Local-only: used to apply SQL migrations with psql. Never imported by the app.
# DATABASE_URL=
